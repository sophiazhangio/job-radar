{
  "name": "job-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Pull job postings from public job boards and score them against your resume, for any career profile.",
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "setup": "node src/setup.ts",
    "scan": "node src/cli.ts scan",
    "match": "node src/cli.ts match",
    "skills": "node src/cli.ts skills",
    "profiles": "node src/cli.ts profiles",
    "open": "node src/cli.ts open",
    "dump": "node src/cli.ts dump",
    "new-profile": "node src/cli.ts new-profile",
    "add-company": "node src/cli.ts add-company",
    "tailor": "node src/cli.ts tailor",
    "applied": "node src/cli.ts applied",
    "test": "node --test src/*.test.ts"
  },
  "dependencies": {
    "unpdf": "1.1.0"
  },
  "license": "MIT"
}
